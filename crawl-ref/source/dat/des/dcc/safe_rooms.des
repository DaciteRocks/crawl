###############################################################################
# safe_rooms.des: Crawl Live (DCC) safe-room vaults.
#
# Every connected-branch floor of a Crawl Live game gets exactly one of these
# (dcc-room.cc places it; on D:1 it is the arrival vault). It holds all of
# the floor's up stairs, so every arrival lands inside, plus a general shop
# that charges normal DCSS prices and the loot box kiosk (K): a plain floor
# cell whose marker opens the player's boxes when they step onto it
# (dcc_kiosk_activate() in dlua/dcc.lua, dcc-boxes.cc), and whose dcc_kiosk
# property is what makes it a kiosk. The epilogue sets up the floor's quest
# on the player's first arrival (dcc_quest_setup() in dlua/dcc_quests.lua).
# The Floor Steward (1) offers that quest: a good neutral human whose
# MonPropsMarker gives it the dcc_steward prop (it keeps its post and is
# worth no XP, achievement or quest credit, dcc-safe.cc, dcc-quest.cc,
# though trunk's kill list still records it), and whose cell's
# function_in_los marker makes the offer when the player sees it
# (dcc_steward_seen() in dlua/dcc.lua, dcc_quest_offer()).
# Every cell inside the walls is dcc_safe:
# hostile monsters cannot enter, and there is no combat inside (dcc-safe.cc).
# The door stays an ordinary cell, the way out for a hostile that ends up
# inside.
#
# Placement relies on these shapes as written: dcc-room.cc reads the map
# lines to find the one door and digs the room into solid rock with the door
# opening onto floor, so the maps are never rotated or mirrored. Each variant
# has its door on a different side. Keep the outer ring all wall except the
# door, keep exactly one door, and keep every variant's header block the
# same.
#
# Never placed at random: no DEPTH, and dcc_only keeps them out of every
# other game type (maps.cc, dungeon.cc). allow_dup lets the same variant
# appear on many floors. no_wall_fixup keeps the room's walls plain rock: on
# Slime they would turn slimy and corrode everyone standing beside them (in
# Dis and the Crypt the room simply stays rock).
###############################################################################

: crawl_require('dlua/dcc.lua')
: crawl_require('dlua/dcc_quests.lua')

# Door to the south.
NAME:   dcc_safe_room_a
TAGS:   dcc_safe_room dcc_only allow_dup no_monster_gen no_tele_into
TAGS:   no_trap_gen no_item_gen no_mimic no_pool_fixup no_wall_fixup
TAGS:   no_rotate no_hmirror no_vmirror transparent
ORIENT: float
KFEAT:  S = general shop count:8 name:Commissary type:Store
KFEAT:  K = floor
KPROP:  .{([SK1 = dcc_safe
MARKER: K = lua:function_at_spot("dcc_kiosk_activate", {}, true, { feature_description = "a loot box kiosk", dcc_kiosk = "1" })
MONS:   human name:Floor_Steward n_rpl n_des att:good_neutral
MARKER: 1 = lua:MonPropsMarker:new {dcc_steward = 1}
MARKER: 1 = lua:function_in_los("dcc_steward_seen", {}, true, { dcc_steward_post = "1" })
epilogue{{
  dcc_quest_setup(_G)
}}
MAP
xxxxxxxxx
x{..S..(x
x.....1.x
x[..K...x
xxxx+xxxx
ENDMAP

